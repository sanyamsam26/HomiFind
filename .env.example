# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: Your Supabase Project URL
SUPABASE_URL="https://myskqtyhoinngdslgccd.supabase.co"

# SUPABASE_ANON_KEY: Public Anon Key for client SDKs
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im15c2txdHlob2lubmdkc2xnY2NkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODYyNjk4ODIsImV4cCI6MjEwMTg0NTg4Mn0.HcIvxtDwuUS_luLNpRjLcmouC01I9JjeEj_WJq0XoPk"

# SUPABASE_SERVICE_ROLE_KEY: Secret Service Role Key for Edge Functions / Admin tasks
